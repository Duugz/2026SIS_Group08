# Copy this file to .env and fill in your values from:
# Supabase dashboard -> Project Settings -> API

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# "anon public" / "publishable" key (safe for client apps - protected by Row Level Security)
EXPO_PUBLIC_SUPABASE_KEY=

# Optional MapTiler key (free at https://cloud.maptiler.com/account/keys/).
# Leave blank to use the free OpenFreeMap style; set it to switch the map to MapTiler satellite tiles.
EXPO_PUBLIC_MAPTILER_KEY=
